[
  { "id": "valid", "text": "{\"id\":1,\"ok\":true,\"tag\":null}", "max": 1000,
    "spans": [["{", "punct"], ["\"id\"", "key"], [":", "punct"], ["1", "number"], [",", "punct"], ["\"ok\"", "key"], [":", "punct"], ["true", "keyword"], [",", "punct"], ["\"tag\"", "key"], [":", "punct"], ["null", "keyword"], ["}", "punct"]] },
  { "id": "nested", "text": "{\"a\":{\"b\":[1,false,{\"c\":\"d\"}]},\"e\":[]}", "max": 1000,
    "spans": [["{", "punct"], ["\"a\"", "key"], [":", "punct"], ["{", "punct"], ["\"b\"", "key"], [":", "punct"], ["[", "punct"], ["1", "number"], [",", "punct"], ["false", "keyword"], [",", "punct"], ["{", "punct"], ["\"c\"", "key"], [":", "punct"], ["\"d\"", "string"], ["}", "punct"], ["]", "punct"], ["}", "punct"], [",", "punct"], ["\"e\"", "key"], [":", "punct"], ["[", "punct"], ["]", "punct"], ["}", "punct"]] },
  { "id": "strings in an array are values", "text": "[\"a\",\"b\"]", "max": 1000,
    "spans": [["[", "punct"], ["\"a\"", "string"], [",", "punct"], ["\"b\"", "string"], ["]", "punct"]] },
  { "id": "escapes", "text": "{\"q\":\"say \\\"hi\\\" \\\\\",\"u\":\"caf\\u00e9\"}", "max": 1000,
    "spans": [["{", "punct"], ["\"q\"", "key"], [":", "punct"], ["\"say \\\"hi\\\" \\\\\"", "string"], [",", "punct"], ["\"u\"", "key"], [":", "punct"], ["\"caf\\u00e9\"", "string"], ["}", "punct"]] },
  { "id": "korean and emoji", "text": "{\"이름\":\"김현교\",\"e\":\"🎉🚀\",\"n\":-1.5e3}", "max": 1000,
    "spans": [["{", "punct"], ["\"이름\"", "key"], [":", "punct"], ["\"김현교\"", "string"], [",", "punct"], ["\"e\"", "key"], [":", "punct"], ["\"🎉🚀\"", "string"], [",", "punct"], ["\"n\"", "key"], [":", "punct"], ["-1.5e3", "number"], ["}", "punct"]] },
  { "id": "pretty-printed (json keeps its whitespace)", "text": "{\n  \"a\": [1, 2]\n}", "max": 1000,
    "spans": [["{", "punct"], ["\"a\"", "key"], [":", "punct"], ["[", "punct"], ["1", "number"], [",", "punct"], ["2", "number"], ["]", "punct"], ["}", "punct"]] },
  { "id": "invalid: the rest is plain", "text": "{\"a\":1, oops: 2}", "max": 1000,
    "spans": [["{", "punct"], ["\"a\"", "key"], [":", "punct"], ["1", "number"], [",", "punct"]] },
  { "id": "unbalanced bracket: the rest is plain", "text": "[1}, 2]", "max": 1000,
    "spans": [["[", "punct"], ["1", "number"]] },
  { "id": "cut mid-string", "text": "{\"note\":\"a long valu", "max": 1000,
    "spans": [["{", "punct"], ["\"note\"", "key"], [":", "punct"], ["\"a long valu", "string"]] },
  { "id": "cut mid-escape", "text": "[\"a\\", "max": 1000,
    "spans": [["[", "punct"], ["\"a\\", "string"]] },
  { "id": "cut mid-keyword", "text": "[true,fa", "max": 1000,
    "spans": [["[", "punct"], ["true", "keyword"], [",", "punct"], ["fa", "keyword"]] },
  { "id": "max_chars cuts the text", "text": "{\"key\":\"value\"}", "max": 9,
    "spans": [["{", "punct"], ["\"key\"", "key"], [":", "punct"], ["\"v", "string"]] },
  { "id": "max_chars cuts a key", "text": "{\"key\":1}", "max": 3,
    "spans": [["{", "punct"], ["\"k", "key"]] },
  { "id": "max_chars counts characters, not bytes", "text": "[\"🎉한글\"]", "max": 3,
    "spans": [["[", "punct"], ["\"🎉", "string"]] },
  { "id": "max_chars 0", "text": "{}", "max": 0, "spans": [] },
  { "id": "scalar string", "text": "\"plain\"", "max": 1000, "spans": [["\"plain\"", "string"]] },
  { "id": "scalar number", "text": "42", "max": 1000, "spans": [["42", "number"]] },
  { "id": "empty", "text": "", "max": 1000, "spans": [] },
  { "id": "not JSON", "text": "hello", "max": 1000, "spans": [] }
]
